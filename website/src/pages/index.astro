---
import { Code } from 'astro-expressive-code/components';
import '../styles/global.css';

const repositoryUrl = 'https://github.com/tylerbutler/windsock';
const readmeUrl = repositoryUrl + '#readme';
const sourceUrl = repositoryUrl + '/blob/main/src/windsock.gleam';

const primitives = [
  {
    name: 'Socket.IO event frames',
    detail: 'Encode and decode text packets shaped like 42["event", ...args].',
    ownedBy: 'windsock',
    code: 'encode(event, args)',
  },
  {
    name: 'Dynamic positional args',
    detail: 'Keep event arguments dynamic so callers decode with their own schema.',
    ownedBy: 'caller',
    code: 'Incoming(event: String, args: List(Dynamic))',
  },
  {
    name: 'Engine.IO heartbeat constants',
    detail: 'Expose ping and pong packets without owning transport negotiation.',
    ownedBy: 'windsock',
    code: 'ping == "2" / pong == "3"',
  },
];

const scopeRows = [
  ['Encodes', 'Socket.IO event packets with caller-provided event names and JSON args.'],
  ['Decodes', 'Text event frames into an event name plus dynamic positional payloads.'],
  ['Exposes', 'Engine.IO ping and pong packet constants for heartbeat boundaries.'],
  ['Leaves out', 'Namespaces, ACK ids, binary attachments, reconnection, and transport negotiation.'],
];

const apiItems = [
  ['encode(event, args)', 'Returns a Socket.IO 42[...] event packet.'],
  ['decode(text)', 'Returns Result(Incoming, DecodeError).'],
  ['ping / pong', 'Expose Engine.IO heartbeat packet constants.'],
];

const errors = [
  ['InvalidJson', 'The frame prefix was right, but the JSON payload could not parse.'],
  ['InvalidFormat', 'The packet was not a Socket.IO event array, or the event name was not a string.'],
];

const frameExample = '42["submitOp", "client-1", []]';
const installSnippet = [
  '[dependencies]',
  'windsock = { git = "https://github.com/tylerbutler/windsock", ref = "main" }',
].join('\n');
const encodeExample = [
  'import gleam/json',
  'import windsock',
  '',
  'pub fn frame() {',
  '  windsock.encode("submitOp", [',
  '    json.string("client-1"),',
  '    json.preprocessed_array([]),',
  '  ])',
  '}',
].join('\n');
const encodeOutput = 'Ok("42[\\"submitOp\\",\\"client-1\\",[]]")';
const decodeExample = [
  'case windsock.decode("42[\\"op\\",\\"c1\\"]") {',
  '  Ok(incoming) -> incoming.event',
  '  Error(windsock.InvalidFormat(reason)) -> reason',
  '  Error(windsock.InvalidJson(reason)) -> reason',
  '}',
].join('\n');
const decodeOutput = 'Ok(Incoming(event: "op", args: [<Dynamic>]))';
const errorExample = [
  'case windsock.decode("42{not-json}") {',
  '  Error(windsock.InvalidJson(reason)) -> reason',
  '  other -> other',
  '}',
].join('\n');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta
      name="description"
      content="windsock provides narrow Socket.IO and Engine.IO text-frame primitives for Gleam."
    />
    <title>windsock · Socket.IO frame primitives for Gleam</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" aria-label="Site header">
      <nav class="nav" aria-label="Primary navigation">
        <a class="brand" href="/" aria-label="windsock home">
          <span class="brand-mark" aria-hidden="true">42</span>
          <span>windsock</span>
        </a>
        <div class="nav-links">
          <a href="#quick-start">Quick start</a>
          <a href="#api">API</a>
          <a href={readmeUrl}>README</a>
          <a href={repositoryUrl}>GitHub</a>
        </div>
      </nav>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="context-line">Gleam primitives for text-frame boundaries</p>
          <h1 id="hero-title">Socket.IO frames, kept deliberately small.</h1>
          <p class="hero-text">
            windsock encodes and decodes the text packets your higher-level protocol already knows how to name. It handles the frame shape; you keep ownership of schemas, sessions, transports, and application vocabulary.
          </p>
          <div class="hero-actions" aria-label="Primary actions">
            <a class="button primary" href="#install">Install windsock</a>
            <a class="button secondary" href={readmeUrl}>Read README</a>
            <a class="button text" href={sourceUrl}>View source</a>
          </div>
        </div>

        <aside class="frame-panel" aria-label="Example Socket.IO event frame">
          <Code code={frameExample} lang="text" title="Socket.IO event frame" wrap />
          <dl class="frame-parts">
            <div>
              <dt>42</dt>
              <dd>Socket.IO event packet</dd>
            </div>
            <div>
              <dt>"submitOp"</dt>
              <dd>Caller-owned event name</dd>
            </div>
            <div>
              <dt>args</dt>
              <dd>Dynamic positional payload</dd>
            </div>
          </dl>
        </aside>
      </section>

      <section class="boundary" aria-labelledby="boundary-title">
        <div class="boundary-copy">
          <h2 id="boundary-title">A frame library, not a client stack.</h2>
          <p>
            windsock is intentionally narrow: enough frame handling to trust at a protocol boundary, without pretending to own the rest of your Socket.IO or Engine.IO integration.
          </p>
        </div>
        <dl class="scope-table" aria-label="Supported and unsupported scope">
          {scopeRows.map(([term, detail]) => (
            <div>
              <dt>{term}</dt>
              <dd>{detail}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="primitive-section" aria-labelledby="primitives-title">
        <div class="section-heading compact">
          <h2 id="primitives-title">Three primitives, one protocol job each.</h2>
          <p>Each exposed surface keeps the Socket.IO frame boundary explicit while leaving application vocabulary above this layer.</p>
        </div>
        <div class="primitive-list">
          {primitives.map((primitive) => (
            <article class="primitive-item">
              <div>
                <h3>{primitive.name}</h3>
                <p>{primitive.detail}</p>
              </div>
              <div class="primitive-meta">
                <span>{primitive.ownedBy}</span>
                <code>{primitive.code}</code>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="quick-start" class="quick-start" aria-labelledby="quick-start-title">
        <div class="section-heading">
          <p class="section-label">Quick start</p>
          <h2 id="quick-start-title">Install, encode, decode, and handle the bad frame.</h2>
        </div>
        <div id="install" class="install-strip" aria-label="Install windsock">
          <div>
            <h3>Add the git dependency</h3>
            <p>windsock is pre-1.0 and not published on Hex yet. Add it explicitly under dependencies from the main branch.</p>
          </div>
          <Code code={installSnippet} lang="toml" title="gleam.toml" />
        </div>
        <div class="code-sequence" aria-label="Quick start examples">
          <article class="example-step">
            <div class="step-copy">
              <span>1</span>
              <h3>Encode a caller-owned event</h3>
              <p>Pass the event name and JSON arguments; windsock only shapes the Socket.IO event packet.</p>
            </div>
            <Code code={encodeExample} lang="gleam" title="src/frame.gleam" />
            <Code code={encodeOutput} lang="text" title="result" frame="none" wrap />
          </article>
          <article class="example-step">
            <div class="step-copy">
              <span>2</span>
              <h3>Decode at your own boundary</h3>
              <p>Keep argument schemas in your caller while windsock verifies the packet shape.</p>
            </div>
            <Code code={decodeExample} lang="gleam" title="src/decode.gleam" />
            <Code code={decodeOutput} lang="text" title="shape" frame="none" wrap />
          </article>
          <article class="example-step">
            <div class="step-copy">
              <span>3</span>
              <h3>Branch on explicit errors</h3>
              <p>Malformed JSON and malformed event arrays stay separate so callers can report the right failure.</p>
            </div>
            <Code code={errorExample} lang="gleam" title="src/error.gleam" />
          </article>
        </div>
      </section>

      <section id="api" class="api-section" aria-labelledby="api-title">
        <div class="api-intro">
          <h2 id="api-title">Small return types make failure explicit.</h2>
          <p>
            The public API is short enough to scan in one pass. Use the source module and README for signatures while the package is pre-1.0.
          </p>
        </div>
        <div class="api-reference">
          <article class="signature">
            <h3>Core functions</h3>
            <dl class="reference-list">
              {apiItems.map(([name, detail]) => (
                <div>
                  <dt><code>{name}</code></dt>
                  <dd>{detail}</dd>
                </div>
              ))}
            </dl>
          </article>
          <article class="signature">
            <h3>Decode errors</h3>
            <dl class="error-list">
              {errors.map(([name, detail]) => (
                <div>
                  <dt><code>{name}</code></dt>
                  <dd>{detail}</dd>
                </div>
              ))}
            </dl>
          </article>
        </div>
        <div class="final-cta">
          <p>Ready to wire frames into your own protocol layer?</p>
          <a class="button primary" href="#install">Copy the dependency snippet</a>
          <a class="button secondary" href={sourceUrl}>Open source module</a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div>
        <strong>windsock</strong>
        <span>Socket.IO frame primitives for Gleam.</span>
      </div>
      <nav aria-label="Footer navigation">
        <a href="#install">Install</a>
        <a href={readmeUrl}>README</a>
        <a href={sourceUrl}>API source</a>
        <a href={repositoryUrl}>Repository</a>
      </nav>
    </footer>

    <script>
      const links = [...document.querySelectorAll('.nav-links a[href^="#"]')];
      const sections = links
        .map((link) => document.querySelector(link.getAttribute('href') || ''))
        .filter(Boolean);

      if ('IntersectionObserver' in window && links.length > 0) {
        const observer = new IntersectionObserver(
          (entries) => {
            const active = entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0]?.target;

            if (!active) return;

            for (const link of links) {
              const selected = link.getAttribute('href') === '#' + active.id;
              link.toggleAttribute('aria-current', selected);
            }
          },
          { rootMargin: '-25% 0px -60% 0px', threshold: [0.1, 0.4, 0.8] },
        );

        sections.forEach((section) => observer.observe(section));
      }
    </script>
  </body>
</html>
